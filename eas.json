{
"cli": {
"version": ">= 21.2.0",
"appVersionSource": "remote"
},
"build": {
"development": {
"developmentClient": true,
"distribution": "internal",
"autoIncrement": true,
"env": {
"APP_VARIANT": "development"
}
},
"preview": {
"distribution": "internal",
"channel": "preview",
"autoIncrement": true,
"env": {
"APP_VARIANT": "preview"
}
},
"production": {
"autoIncrement": true,
"channel": "production",
"android": {
"buildType": "app-bundle"
},
"env": {
"APP_VARIANT": "production"
}
}
},
"submit": {
"production": {}
}
}